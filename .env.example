# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# cloudhike.dev — copy real values into .env.local (git-ignored), never commit them.
# Postgres
DATABASE_URL=
DIRECT_URL=
# Auth (Google + email/password)
AUTH_URL=
AUTH_PUBLISHABLE_KEY=
AUTH_SECRET_KEY=
# Background jobs (widget refresh)
JOBS_API_URL=
JOBS_API_KEY=
# AI providers: anthropic (default) | gemini | cloudhike
AI_PROVIDER=anthropic
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_HEAVY_MODEL=claude-opus-5-5
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# cloudhike AI models (OpenAI-compatible; also the fallback when a key is missing)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5
AI_FAST_MODEL=anthropic/claude-haiku-5.5
# Cloud computer (later phases)
COMPUTERS_API_URL=
COMPUTERS_API_KEY=

# Composio (external tools: Gmail, Calendar, Notion…). Get it at dashboard.composio.dev/settings
COMPOSIO_API_KEY=
